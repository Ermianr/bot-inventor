{
  "name": "desktop",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "lint": "pnpm run i18n && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run i18n && svelte-check --tsconfig ./tsconfig.json",
    "effect": "pnpm run i18n && effect-language-service diagnostics --project tsconfig.json",
    "test": "pnpm run i18n && vitest run",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xyflow/svelte": "1.7.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "4.0.5",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-message-format": "^4.5.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
