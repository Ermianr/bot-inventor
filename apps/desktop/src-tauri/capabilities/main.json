{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: it may call the commands listed here and nothing else.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-new-project",
    "allow-open-project",
    "allow-save-project",
    "allow-validate-project",
    "allow-node-catalog",
    "allow-expression-names",
    "allow-condition-to-source",
    "allow-condition-from-source",
    "allow-rename-alias",
    "allow-start-bot",
    "allow-stop-bot",
    "allow-set-token",
    "allow-token-status",
    "allow-set-dev-guild",
    "allow-export-bot"
  ]
}
