{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:routes dev:server",
    "dev:routes": "bun run ../../scripts/route-tree.ts --watch",
    "dev:server": "cd ../.. && bun run apps/web/dev-server.ts",
    "routes": "bun run ../../scripts/route-tree.ts",
    "build": "bun run routes && bun run build.ts",
    "check-types": "bun run build && tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "sidecar": "bun run ../../scripts/prepare-sidecar.ts",
    "desktop:dev": "bun run sidecar && tauri dev",
    "desktop:build": "bun run sidecar && tauri build"
  },
  "dependencies": {
    "@bot-inventor/compiler": "workspace:*",
    "@bot-inventor/nodes": "workspace:*",
    "@bot-inventor/runtime": "workspace:*",
    "@bot-inventor/schema": "workspace:*",
    "@bot-inventor/ui": "workspace:*",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-router": "^1.170.18",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xyflow/react": "^12.11.3",
    "dotenv": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@bot-inventor/config": "workspace:*",
    "@happy-dom/global-registrator": "^20.11.6",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.32",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "postcss": "^8.5.24",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
