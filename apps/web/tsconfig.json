{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `bun-test.setup.ts` and `react-compiler-plugin.ts` import
    // `./react-compiler.ts` by its real name. Nothing here is emitted, so
    // naming it costs nothing.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*"],
      "@bot-inventor/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
