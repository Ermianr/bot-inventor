{
  "name": "@bot-inventor/compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bot-inventor/nodes": "workspace:*",
    "@bot-inventor/runtime": "workspace:*",
    "@bot-inventor/schema": "workspace:*"
  },
  "devDependencies": {
    "@bot-inventor/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
