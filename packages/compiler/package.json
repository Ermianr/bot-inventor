  },
  "dependencies": {
    "@bot-inventor/nodes": "workspace:*",
    "@bot-inventor/runtime": "workspace:*",
    "@bot-inventor/schema": "workspace:*",
    "dotenv": "catalog:",
    "esbuild": "^0.28.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bot-inventor/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "ws": "^8.21.3"
  }
