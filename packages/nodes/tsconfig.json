{
  "extends": "@bot-inventor/config/tsconfig.base.json",
  // The tests run on `bun test`, so `bun:test` has to resolve. The base config
  // names `node` alone, and naming any type package replaces that list rather
  // than adding to it, so `node` is repeated here.
  "compilerOptions": { "types": ["node", "bun"] },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
